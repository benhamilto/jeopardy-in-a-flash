{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jeopardy-in-a-flash",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"assets": {
		"directory": ".",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jservice",
			"database_id": "29b70317-34c3-43f7-abc7-9fc941dc234b"
		}
	]
}